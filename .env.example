# Server
PORT=3000

# PostgreSQL connection string
# Special characters in the password must be URL-encoded (@ becomes %40)
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/ecomm_auth

# Base URL used in emailed links (no trailing slash)
# Local: include the port. Production: the public URL with no port
APP_URL=http://localhost:3000

# JWT (random value, at least 32 characters)
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=1h

# Admin registration key (random, at least 32 characters, different from JWT_SECRET)
ADMIN_SECRET_KEY=replace_with_a_different_long_random_value

# Allowed browser origins, comma-separated, no trailing slashes
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_dedicated_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=your_dedicated_gmail_address@gmail.com