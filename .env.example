# Server
PORT=3000

# PostgreSQL
PG_USER=your_database_user
PG_PASS=your_database_password
PG_PORT=5432
PG_HOST=localhost
PG_DB=ecomm_auth

# Base URL used in emailed links (include the port, no trailing slash)
APP_URL=http://localhost:3000

# JWT (generate a random value of at least 32 characters)
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=1h

# Admin registration key (random, at least 32 characters, different from JWT_SECRET)
ADMIN_SECRET_KEY=replace_with_a_different_long_random_value

# Resend email
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Allowed browser origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173